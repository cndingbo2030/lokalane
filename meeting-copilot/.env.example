# Server-side only. Never expose these to the browser.
PORT=8790

# Docker deployment (docker-compose.yml): the public domain Caddy gets an HTTPS certificate for.
DOMAIN=

# Speech-to-text: soniox (best for zh/en code-switching) | deepgram | mock
STT_PROVIDER=soniox
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v5
# Optional: upper bound (ms, 500–3000) for Soniox to close a sentence after the speaker stops.
# Empty keeps Soniox's default (2000). Lower is faster but may split sentences at short pauses.
SONIOX_MAX_ENDPOINT_DELAY_MS=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Claude (translation, live copilot, summaries). Without a key the server runs a mock LLM.
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-5-5
TRANSLATE_MODEL=claude-opus-5-5
SUMMARY_MODEL=claude-opus-5-5

# Optional shared secret; when set, the browser must connect with ?token=...
ACCESS_TOKEN=
# Comma-separated list of allowed browser origins (empty = same origin + localhost dev)
ALLOWED_ORIGINS=

# Let calendar feeds and webhooks reach private / LAN addresses (self-hosted n8n, intranet calendars).
# Keep false on internet-facing servers (SSRF protection). The desktop app always allows it.
ALLOW_PRIVATE_NETWORK=false

# Meeting bot mode (Attendee, https://attendee.dev — hosted or self-hosted): a bot joins
# Zoom / Google Meet / Teams and streams the meeting audio back over wss://PUBLIC_URL/ws/bot.
ATTENDEE_API_KEY=
ATTENDEE_BASE_URL=https://app.attendee.dev
# This server's public https address (a tunnel such as cloudflared works for testing).
PUBLIC_URL=

# Production limits. TRUST_PROXY=true only behind a reverse proxy you control (docker-compose sets it).
TRUST_PROXY=false
MAX_SESSIONS=50
